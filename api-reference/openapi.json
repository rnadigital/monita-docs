          "webhook": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Webhook",
            "default": false
          }
        },
        "type": "object",
        "title": "Options"
      },
      "ScreenShotUrls": {
        "properties": {
          "screenShotBefore": {
            "type": "string",
            "title": "Screenshotbefore"
          },
